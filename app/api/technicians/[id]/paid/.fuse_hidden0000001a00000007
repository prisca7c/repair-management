import { NextRequest, NextResponse } from "next/server";
import { createAdminClient as createClient } from "@/lib/supabase/admin";

export const dynamic = "force-dynamic";

/**
 * Marks a repair's technician payment as paid (undoable via the standard
 * undo endpoint on that repair — action "technician_paid").
 * NOTE: the [id] param here is the REPAIR id, not the technician id, since
 * technician pay is tracked per-repair (a technician can have several
 * unpaid jobs). Route is nested under /api/technicians for spec parity.
 */
export async function POST(
  _req: NextRequest,
  { params }: { params: Promise<{ id: string }> }
) {
  const { id: repairId } = await params;
  const supabase = await createClient();
  const {
    data: { user },
  } = await supabase.auth.getUser();
  if (!user) return NextResponse.json({ error: "Unauthorized" }, { status: 401 });

  const { data: appUser } = await supabase.from("users").select("*").eq("id", user.id).maybeSingle();

  const { data: before } = await supabase.from("repairs").select("*").eq("id", repairId).single();
  if (!before) return NextResponse.json({ error: "Repair not found" }, { status: 404 });

  const paidAt = new Date().toISOString();
  const { data: after, error } = await supabase
    .from("repairs")
    .update({ technician_paid: true, technician_paid_at: paidAt })
    .eq("id", repairId)
    .select("*")
    .single();
  if (error) return NextResponse.json({ error: error.message }, { status: 400 });

  await supabase.from("audit_log").insert({
    repair_id: repairId,
    actor_id: appUser?.id ?? null,
    actor_name: appUser?.name ?? null,
    action: "technician_paid",
    from_value: { technician_paid: before.technician_paid, technician_paid_at: before.technician_paid_at },
    to_value: { technician_paid: after?.technician_paid, technician_paid_at: after?.technician_paid_at },
  });

  return NextResponse.json({ ok: true, repair: after, undoUrl: `/api/repairs/${repairId}/undo` });
}
