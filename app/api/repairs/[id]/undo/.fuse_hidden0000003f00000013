import { NextRequest, NextResponse } from "next/server";
import { createClient } from "@/lib/supabase/server";

export const dynamic = "force-dynamic";

/**
 * Reverts the most recent (non-undo) audit_log entry for this repair.
 * Writes a new "undo" audit entry describing the reversal — history is
 * never deleted, only added to.
 *
 * Special case: reverting a "quote_approval_cancelled" entry restores the
 * ORIGINAL quote_approvals row to its prior state (re-linking the original
 * approval event) rather than fabricating a brand new "approved" response.
 */
export async function POST(
  _req: NextRequest,
  { params }: { params: Promise<{ id: string }> }
) {
  const { id } = await params;
  const supabase = await createClient();
  const {
    data: { user },
  } = await supabase.auth.getUser();
  if (!user) return NextResponse.json({ error: "Unauthorized" }, { status: 401 });

  const { data: appUser } = await supabase
    .from("users")
    .select("*")
    .eq("id", user.id)
    .maybeSingle();

  // Most recent entry that isn't itself an undo of something (skip entries
  // whose action already starts with "undo_" so double-undo doesn't loop).
  const { data: entries } = await supabase
    .from("audit_log")
    .select("*")
    .eq("repair_id", id)
    .order("created_at", { ascending: false })
    .limit(10);

  const target = (entries ?? []).find((e) => !e.action.startsWith("undo_"));

  if (!target) {
    return NextResponse.json({ error: "Nothing to undo" }, { status: 400 });
  }

  const actorId = appUser?.id ?? null;
  const actorName = appUser?.name ?? null;

  switch (target.action) {
    case "field_update": {
      const fromValue = target.from_value as Record<string, unknown> | null;
      if (!fromValue) {
        return NextResponse.json({ error: "Cannot undo — no prior state recorded" }, { status: 400 });
      }
      const { data: current } = await supabase.from("repairs").select("*").eq("id", id).single();
      const { data: reverted, error } = await supabase
        .from("repairs")
        .update(fromValue)
        .eq("id", id)
        .select("*")
        .single();
      if (error) return NextResponse.json({ error: error.message }, { status: 400 });

      await supabase.from("audit_log").insert({
        repair_id: id,
        actor_id: actorId,
        actor_name: actorName,
        action: "undo_field_update",
        from_value: current,
        to_value: reverted,
      });
      return NextResponse.json({ ok: true, repair: reverted });
    }

    case "quote_approval_cancelled": {
      // target.to_value holds the approval id + the state it was cancelled
      // into; target.from_value holds the approval row exactly as it was
      // before cancellation. Restore that prior state verbatim so we
      // reinstate the ORIGINAL approval event rather than inventing a new
      // "approved" response.
      const fromValue = target.from_value as Record<string, unknown> | null;
      const approvalId = fromValue?.id as string | undefined;
      if (!fromValue || !approvalId) {
        return NextResponse.json({ error: "Cannot undo — no prior approval state recorded" }, { status: 400 });
      }

      const { data: current } = await supabase
        .from("quote_approvals")
        .select("*")
        .eq("id", approvalId)
        .single();

      const { error } = await supabase
        .from("quote_approvals")
        .update({
          response: fromValue.response,
          responded_at: fromValue.responded_at,
          cancelled_by_staff: fromValue.cancelled_by_staff,
          cancelled_by_user_id: fromValue.cancelled_by_user_id,
          cancelled_at: fromValue.cancelled_at,
          cancellation_reason: fromValue.cancellation_reason,
        })
        .eq("id", approvalId);
      if (error) return NextResponse.json({ error: error.message }, { status: 400 });

      await supabase.from("audit_log").insert({
        repair_id: id,
        actor_id: actorId,
        actor_name: actorName,
        action: "undo_quote_approval_cancelled",
        from_value: current,
        to_value: fromValue,
      });
      return NextResponse.json({ ok: true });
    }

    case "collect": {
      const fromValue = target.from_value as Record<string, unknown> | null;
      if (!fromValue) {
        return NextResponse.json({ error: "Cannot undo — no prior state recorded" }, { status: 400 });
      }
      const { data: current } = await supabase.from("repairs").select("*").eq("id", id).single();
      const { data: reverted, error } = await supabase
        .from("repairs")
        .update({
          status: fromValue.status,
          customer_paid: fromValue.customer_paid,
          collected_at: fromValue.collected_at,
        })
        .eq("id", id)
        .select("*")
        .single();
      if (error) return NextResponse.json({ error: error.message }, { status: 400 });

      await supabase.from("audit_log").insert({
        repair_id: id,
        actor_id: actorId,
        actor_name: actorName,
        action: "undo_collect",
        from_value: current,
        to_value: reverted,
      });
      return NextResponse.json({ ok: true, repair: reverted });
    }

    case "archive": {
      const { data: current } = await supabase.from("repairs").select("*").eq("id", id).single();
      const { data: reverted, error } = await supabase
        .from("repairs")
        .update({ archived_at: null })
        .eq("id", id)
        .select("*")
        .single();
      if (error) return NextResponse.json({ error: error.message }, { status: 400 });

      await supabase.from("audit_log").insert({
        repair_id: id,
        actor_id: actorId,
        actor_name: actorName,
        action: "undo_archive",
        from_value: current,
        to_value: reverted,
      });
      return NextResponse.json({ ok: true, repair: reverted });
    }

    case "technician_paid": {
      const { data: current } = await supabase.from("repairs").select("*").eq("id", id).single();
      const { data: reverted, error } = await supabase
        .from("repairs")
        .update({ technician_paid: false, technician_paid_at: null })
        .eq("id", id)
        .select("*")
        .single();
      if (error) return NextResponse.json({ error: error.message }, { status: 400 });

      await supabase.from("audit_log").insert({
        repair_id: id,
        actor_id: actorId,
        actor_name: actorName,
        action: "undo_technician_paid",
        from_value: current,
        to_value: reverted,
      });
      return NextResponse.json({ ok: true, repair: reverted });
    }

    default:
      return NextResponse.json(
        { error: `"${target.action}" cannot be undone automatically.` },
        { status: 400 }
      );
  }
}
